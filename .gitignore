dist/
build/
*.tsbuildinfo

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Tests
coverage/
.nyc_output/

# Logs
logs/
*.log

# Env / secrets
.env
.env.local
.env.*.local
*.local

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Prisma migrations sont versionnées, mais pas les db locales
prisma/*.db
prisma/*.db-journal

# OpenAPI artefact regénéré à chaque bootstrap
openapi.json

# Docs internes (non publiées)
# docs/interne/ = sprints uniquement ; docs/travail/ = matière de travail (context-ia, specs, guides, reviews)
docs/interne/
docs/travail/

# Claude Code config locale
.claude/

# Images conteneur construites localement (artefacts de déploiement)
*.tar

# BMad Method — installation partagee dans C:\Appsmad, branchee par jonctions
# Windows (voir C:\Appsmad\link-project.ps1). Non portable : on relie, on ne versionne pas.
/_bmad/
/_bmad-output/
