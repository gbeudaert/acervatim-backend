# Copie vers .env et remplis les valeurs. Le .env n'est jamais commit.

# === Server ===
PORT=3000
NODE_ENV=development

# === Redis (BullMQ — throttle sortant + single-flight des appels sources) ===
# En dev docker-compose : le compose surcharge REDIS_HOST pour pointer sur host=redis.
# Hors compose (local), garder localhost (port 6379 publié par le conteneur redis).
REDIS_HOST=localhost
REDIS_PORT=6379

# === MariaDB (utilisé par docker-compose pour init du conteneur db) ===
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=acervatim
MARIADB_USER=acervatim
MARIADB_PASSWORD=changeme

# === Database URL ===
# En dev docker-compose : le compose surcharge DATABASE_URL pour pointer sur host=db.
# Pour les commandes Prisma exécutées HORS compose (ex: prisma:studio en local),
# garder host=localhost ci-dessous (le port 3306 du conteneur db est publié).
DATABASE_URL="mysql://acervatim:changeme@localhost:3306/acervatim"

# === Secrets (jamais commités, à générer avec openssl rand -base64 32) ===
# Pepper HMAC pour hasher les sub Google. CRITIQUE: ne JAMAIS rotater après le 1er user.
SUB_HASH_PEPPER="<base64-32-bytes>"
# Clé AES-256 (base64) pour chiffrer les tokens OAuth en base.
ENCRYPTION_KEY="<base64-32-bytes>"
# Clé privée RS256 PEM pour signer les JWT internes (multi-ligne en .env : entourer de quotes).
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Clé publique correspondante (pour vérifier les JWT côté authorizer si besoin).
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Pepper HMAC pour hasher les codes d'invitation. Doit être distinct de SUB_HASH_PEPPER.
INVITE_CODE_PEPPER="<base64-32-bytes>"
# Token bearer pour les endpoints /admin/invitations (création/listing).
# À remplacer par un vrai schéma d'auth admin quand dispo.
ADMIN_API_TOKEN="<random-32-bytes>"

# === Google OAuth ===
# Audience de l'id_token verifie par le backend = le WEB client ID
# (celui passe comme serverClientId par l'app Android), PAS le client Android.
GOOGLE_CLIENT_ID="xxxxxxxxx.apps.googleusercontent.com"

# === Discogs OAuth 1.0a ===
DISCOGS_CONSUMER_KEY=""
DISCOGS_CONSUMER_SECRET=""
# Personal access token d'un compte Discogs Acervatim (Settings > Developers), pour
# le repli premium : donne 60 req/min ET les images. Sans lui, le repli retombe sur
# la signature consumer-only (authentifiée, mais SANS jaquettes).
DISCOGS_ACERVATIM_TOKEN=""

# === MyAnimeList OAuth 2.0 (PKCE) — pivot manga ===
# Sans MAL_CLIENT_ID, le pivot manga échoue : "mal: not configured".
MAL_CLIENT_ID=""
MAL_CLIENT_SECRET=""

# === Google Books — jaquettes par ISBN (scan manga, endpoint /v1/search/cover) ===
# Optionnelle mais FORTEMENT recommandée : sans clé, les appels sont anonymes et
# Google plafonne à un quota minuscule -> 429 systématiques, aucune jaquette de tome.
# Obtenir une clé :
#   1. https://console.cloud.google.com/ -> créer/choisir un projet.
#   2. "APIs & Services" > "Library" > activer "Books API".
#   3. "APIs & Services" > "Credentials" > "Create credentials" > "API key".
#   4. (Recommandé) "Edit API key" > "API restrictions" > restreindre à "Books API".
# La Books API en lecture publique est gratuite ; la clé sert juste à porter le quota.
GOOGLE_BOOKS_API_KEY=""
